# 本地构建时保持下面默认值；使用 GHCR 时改为 ghcr.io/kaibush/grok-register:latest
GROK_REGISTER_IMAGE=grok-register:local
GROK_WEB_PORT=8787
GROK_WEB_COOKIE_SECURE=0
GROK_SHM_SIZE=1gb
XVFB_SCREEN=1920x1080x24
TZ=UTC

# 可选账号监控联动；仅作为 config.json 尚未填写对应字段时的初始默认值。
GROK_MONITOR_WEBHOOK_ENABLED=false
GROK_MONITOR_WEBHOOK_URL=http://monitor-backend:8090/api/integrations/grok-register/account-imported
GROK_MONITOR_WEBHOOK_TOKEN=
GROK_MONITOR_WEBHOOK_TIMEOUT_SECONDS=10

# compose.monitor.yaml 使用的监控镜像与启动参数
MONITOR_BACKEND_IMAGE=ghcr.io/kaibush/grok-account-monitor-backend:latest
MONITOR_FRONTEND_IMAGE=ghcr.io/kaibush/grok-account-monitor-frontend:latest
MONITOR_WEB_BIND=0.0.0.0
MONITOR_WEB_PORT=8091
MONITOR_GROK2API_BASE_URL=http://host.docker.internal:8000
MONITOR_GROK2API_ADMIN_USERNAME=
MONITOR_GROK2API_ADMIN_PASSWORD=
MONITOR_WEBHOOK_TOKEN=
MONITOR_INITIAL_PROBE_ON_REGISTER=true
MONITOR_REGISTER_PROBE_PROFILE_IDS=["quality-marker"]
MONITOR_REGISTER_PROBE_EXECUTION_MODE=chat
MONITOR_REGISTER_PROBE_ROUNDS=3
MONITOR_REGISTER_PROBE_PROXY_TARGETS=[{"kind":"direct","id":null}]
MONITOR_CORS_ORIGINS=https://monitor.lvyrix.com,http://localhost:8091,http://127.0.0.1:8091

# 可选 OutlookEmail 邮箱池（docker compose --profile outlookemail up -d）
OUTLOOKEMAIL_IMAGE=ghcr.io/assast/outlookemail:latest
OUTLOOKEMAIL_PORT=5000
OUTLOOKEMAIL_LOGIN_PASSWORD=change-this-outlookemail-password
# 部署前请替换为随机长字符串：python3 -c 'import secrets; print(secrets.token_hex(32))'
OUTLOOKEMAIL_SECRET_KEY=change-this-outlookemail-secret-key
OUTLOOKEMAIL_DOCKER_UPDATE_ENABLED=true
# 特殊 Docker daemon/socket 代理环境可调整，例如 1.52
OUTLOOKEMAIL_DOCKER_UPDATE_API_VERSION=1.41
# 使用自有 Azure 应用时替换下面两个值
OUTLOOKEMAIL_OAUTH_CLIENT_ID=9e5f94bc-e8a4-4e73-b8be-63364c29d753
OUTLOOKEMAIL_OAUTH_REDIRECT_URI=http://localhost:8080
